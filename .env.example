PORT=3000

# Unique per-attendee tag, drives OTel service name
ATTENDEE_ID=attendee-03

# Must be reliability-workshop-${ATTENDEE_ID}
OTEL_SERVICE_NAME=my-app

# From the Grafana Cloud portal's OpenTelemetry setup page — stack/region-specific, do not hardcode.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-<region>.grafana.net/otlp

# Authorization=Basic <base64(instanceID:apiToken)> — generated when you create the Grafana Cloud API token.
# Secret — do not commit a real value here.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64-encoded-credentials>

# Deliberately small so pool exhaustion is reachable without heavy load.
RESOURCE_POOL_MAX=5

# How long a queued request waits for a free slot before it fails with a 503.
# Tune during your dry run: raise it if a live room can't see the queue build
# before failures start, lower it if the room sits waiting too long.
RESOURCE_POOL_TIMEOUT_MS=4000
